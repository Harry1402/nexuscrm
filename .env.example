# Application Port
PORT=3000
NODE_ENV=development

# Database Settings
MYSQL_ROOT_PASSWORD=change_this_root_password
ESPOCRM_DATABASE_HOST=db
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm
ESPOCRM_DATABASE_PASSWORD=change_this_db_password

# EspoCRM Admin & URL
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change_this_admin_password
ESPOCRM_SITE_URL=http://localhost:8080
ESPOCRM_API_URL=http://espocrm/api/v1
ESPOCRM_API_KEY=your_espocrm_api_key_here

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
SESSION_SECRET=your_session_secret_min_32_chars

# Twilio Credentials (SMS / Voice)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# WhatsApp Credentials
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Email (SMTP) Credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
