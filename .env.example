# ==============================================================================
# NexusCRM Master Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Update passwords and secrets before launching in production.
# 3. All services load secrets strictly via process.env. Zero hardcoded credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MariaDB Database Settings
# ------------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=nexus_root_secure_password
MARIADB_DATABASE=espocrm
MARIADB_USER=espocrm
MARIADB_PASSWORD=nexus_db_secure_password

# ------------------------------------------------------------------------------
# 2. EspoCRM Core Application Settings
# ------------------------------------------------------------------------------
ESPOCRM_DATABASE_HOST=espocrm-db
ESPOCRM_DATABASE_PORT=3306
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm
ESPOCRM_DATABASE_PASSWORD=nexus_db_secure_password

ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=nexus_admin_secure_password
ESPOCRM_SITE_URL=http://localhost:8080

# Generated by running: node scripts/seed-api-user.js
ESPOCRM_API_KEY=

# ------------------------------------------------------------------------------
# 3. MinIO S3-Compatible Object Storage Settings
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_key
MINIO_BUCKET=crm-files
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# 4. Integration API Service Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 5. Twilio SMS & Voice Telephony (Optional for local testing)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 6. Meta WhatsApp Cloud API (Optional for local testing)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=nexus_webhook_verify_token
WHATSAPP_APP_SECRET=

# ------------------------------------------------------------------------------
# 7. SMTP Transactional Email Settings (Optional for local testing)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@nexuscrm.local
